# Thin app-layer overlay on the published nrd-parking-jetson image.
# Context is prepared by tools/build_overlay_images.sh; only core_parking files
# listed there are replaced, everything else (runtime, vision_base, models) is inherited.
ARG BASE_IMAGE=sensecraft-missionpack.seeed.cn/solution/nrd-parking-jetson:20261009@sha256:37ce3447e7486ca43109fc430f639d3a3e1088b79539b811ea154e0b637b5a6d
FROM ${BASE_IMAGE}
ARG SRC_COMMIT=unknown
COPY core_parking/ /opt/edge-parking/core_parking/
LABEL org.opencontainers.image.revision=${SRC_COMMIT} \
      org.opencontainers.image.source=https://github.com/suharvest/edge-parking-vision
