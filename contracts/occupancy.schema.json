{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "occupancy.schema.json",
  "type": "object",
  "unevaluatedProperties": false,
  "allOf": [
    {"$ref": "envelope.schema.json"},
    {
      "type": "object",
      "required": ["occupancy", "capacity", "free", "in_today", "out_today", "reason"],
      "properties": {
        "schema":    {"const": "parking.occupancy/1"},
        "occupancy": {"type": "integer", "minimum": 0},
        "capacity":  {"type": "integer", "minimum": 0},
        "free":      {"type": "integer", "minimum": 0},
        "in_today":  {"type": "integer", "minimum": 0},
        "out_today": {"type": "integer", "minimum": 0},
        "reason":    {"enum": ["crossing", "manual_set", "boot", "daily_rollover"]}
      }
    }
  ]
}
